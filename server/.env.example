# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lazada_hunter

# SQLAlchemy Database URLs
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/ecommerce_crawler
SYNC_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ecommerce_crawler

# Redis Cloud / Local
REDIS_URL=redis://default:your_redis_password@your_redis_host:17709

# Qdrant Cloud Vector Database
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_COLLECTION_NAME=products

# AI Engine & LLM Providers
NVIDIA_API_KEY=nvapi-your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_NOTIFY_ON_PRICE_DROP=True
PRICE_DROP_ALERT_THRESHOLD_PERCENT=5.0

# Crawler Settings
CRAWLER_HEADLESS=True
CRAWLER_MIN_DELAY=2.0
CRAWLER_MAX_DELAY=5.0
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_ROTATE_USER_AGENT=True

# Proxy Settings (Optional)
USE_PROXY=False
PROXY_URL=
ADB_DEVICE_ID=
